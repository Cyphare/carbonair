<Window x:Class="CarbonAirWpf.PollutionAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Peringatan Kualitas Udara"
        Width="390" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Loaded="Window_Loaded">
    <Border x:Name="borderContainer" Margin="10" CornerRadius="12" Background="#141C22" BorderBrush="#E74C3C" BorderThickness="1.5" Padding="18,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Color="#000000" Opacity="0.65" ShadowDepth="6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Row -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="borderIconBg" Width="28" Height="28" CornerRadius="7" Background="#3A1916" Margin="0,0,10,0">
                        <Path x:Name="iconAlert" Width="15" Height="15" Stretch="Uniform" Fill="#E74C3C" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                    </Border>
                    <TextBlock Text="Peringatan Bahaya Polusi" FontSize="13.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="btnClose_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="24" Height="24" CornerRadius="6" Background="#1D2B33">
                                <TextBlock Text="✕" Foreground="#8E9FA8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- City + AQI Pill -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
                <TextBlock x:Name="txtAlertCity" Text="Jakarta" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border x:Name="borderAqiBadge" CornerRadius="6" Background="#3A1916" BorderBrush="#E74C3C" BorderThickness="1" Padding="8,3">
                    <TextBlock x:Name="txtAlertAqi" Text="AQI 165 • Tidak Sehat" FontSize="11" FontWeight="Bold" Foreground="#FF6B6B"/>
                </Border>
            </StackPanel>

            <!-- Advice -->
            <TextBlock Grid.Row="2" x:Name="txtAlertMessage"
                       Text="Gunakan masker N95/KN95 dan kurangi aktivitas luar ruangan."
                       FontSize="12" Foreground="#B8C7D0" TextWrapping="Wrap" LineHeight="18"/>
        </Grid>
    </Border>
</Window>
