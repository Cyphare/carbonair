<Window x:Class="CarbonAirWpf.PollutionAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Peringatan Kualitas Udara"
        Width="370" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Loaded="Window_Loaded">
    <Border x:Name="borderContainer" Margin="10" CornerRadius="8" Background="#FFFFFF"
            BorderBrush="#0F766E" BorderThickness="3,0,0,0" Padding="18,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Color="#111827" Opacity="0.16" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Row -->
            <Grid Grid.Row="0">
                <TextBlock Text="Peringatan Polusi" FontSize="13.5" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>

                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="btnClose_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="24" Height="24" CornerRadius="6" Background="#EBEEF2" BorderThickness="0">
                                <TextBlock Text="✕" Foreground="#111827" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- City + AQI Badge -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,8">
                <TextBlock x:Name="txtAlertCity" Text="Jakarta" FontSize="15" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border x:Name="borderAqiBadge" CornerRadius="4" Background="#F2F4F7" BorderThickness="0" Padding="8,3">
                    <TextBlock x:Name="txtAlertAqi" Text="AQI 165 • Tidak Sehat" FontSize="11" FontWeight="SemiBold" Foreground="#0F766E"/>
                </Border>
            </StackPanel>

            <!-- Advice -->
            <TextBlock Grid.Row="2" x:Name="txtAlertMessage"
                       Text="Gunakan masker N95/KN95 dan kurangi aktivitas luar ruangan."
                       FontSize="12" Foreground="#374151" TextWrapping="Wrap" LineHeight="18"/>
        </Grid>
    </Border>
</Window>
