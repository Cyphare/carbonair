<Window x:Class="CarbonAirWpf.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CarbonAir - Dashboard" Height="740" Width="1120"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF">
    <Grid Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- High-Contrast Light Sidebar -->
        <Border Grid.Column="0" Background="#F2F4F7" BorderThickness="0">
            <Grid Margin="14,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Logo (No square icon box) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,0,0,28">
                    <Path Width="18" Height="18" Stretch="Uniform" Fill="#0F766E" VerticalAlignment="Center"
                          Data="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z"/>
                    <TextBlock Text="CarbonAir" FontSize="16.5" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1">
                    <!-- Nav 1: Dashboard -->
                    <Border x:Name="borderNavDashboard" CornerRadius="6" Background="#FFFFFF" BorderThickness="0" Height="38" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonDown="NavDashboard_Click">
                        <Grid>
                            <Border x:Name="barNavDashboard" Width="3" Height="18" CornerRadius="1.5" Background="#0F766E" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Visible"/>
                            <StackPanel Orientation="Horizontal" Margin="12,0">
                                <Path x:Name="iconNavDashboard" Width="14" Height="14" Stretch="Uniform" Fill="#0F766E" Margin="0,0,11,0" VerticalAlignment="Center"
                                      Data="M3 3h8v8H3V3zm10 0h8v5h-8V3zm0 7h8v11h-8V10zM3 13h8v8H3v-8z"/>
                                <TextBlock x:Name="textNavDashboard" Text="Dashboard" FontSize="13" FontWeight="SemiBold" Foreground="#0F766E" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Nav 2: Peta AQI -->
                    <Border x:Name="borderNavPetaAqi" CornerRadius="6" Background="Transparent" BorderThickness="0" Height="38" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonDown="NavPetaAqi_Click">
                        <Grid>
                            <Border x:Name="barNavPetaAqi" Width="3" Height="18" CornerRadius="1.5" Background="#0F766E" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" Margin="12,0">
                                <Path x:Name="iconNavPetaAqi" Width="14" Height="14" Stretch="Uniform" Fill="#374151" Margin="0,0,11,0" VerticalAlignment="Center"
                                      Data="M9 3L3 6v15l6-3 6 3 6-3V3l-6 3-6-3zm1 3.5l4 2v10l-4-2v-10z"/>
                                <TextBlock x:Name="textNavPetaAqi" Text="Peta AQI" FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Nav 3: Log Energi -->
                    <Border x:Name="borderNavLogEnergi" CornerRadius="6" Background="Transparent" BorderThickness="0" Height="38" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonDown="NavLogEnergi_Click">
                        <Grid>
                            <Border x:Name="barNavLogEnergi" Width="3" Height="18" CornerRadius="1.5" Background="#0F766E" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" Margin="12,0">
                                <Path x:Name="iconNavLogEnergi" Width="14" Height="14" Stretch="Uniform" Fill="#374151" Margin="0,0,11,0" VerticalAlignment="Center"
                                      Data="M3 3v18h18v-2H5V3H3zm4 11l4-4 4 4 6-7-1.4-1.4-4.6 5.4-4-4-5.4 5.4L7 14z"/>
                                <TextBlock x:Name="textNavLogEnergi" Text="Log Energi" FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Nav 4: Pengaturan -->
                    <Border x:Name="borderNavPengaturan" CornerRadius="6" Background="Transparent" BorderThickness="0" Height="38" Margin="0,0,0,4" Cursor="Hand" MouseLeftButtonDown="NavPengaturan_Click">
                        <Grid>
                            <Border x:Name="barNavPengaturan" Width="3" Height="18" CornerRadius="1.5" Background="#0F766E" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" Margin="12,0">
                                <Path x:Name="iconNavPengaturan" Width="14" Height="14" Stretch="Uniform" Fill="#374151" Margin="0,0,11,0" VerticalAlignment="Center"
                                      Data="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm-1-6h2l.7 2.2a8 8 0 0 1 2.3 1l2-1.2 1.4 1.4-1.2 2a8 8 0 0 1 1 2.3L22 11v2l-2.2.7a8 8 0 0 1-1 2.3l1.2 2-1.4 1.4-2-1.2a8 8 0 0 1-2.3 1L13 22h-2l-.7-2.2a8 8 0 0 1-2.3-1l-2 1.2-1.4-1.4 1.2-2a8 8 0 0 1-1-2.3L2 13v-2l2.2-.7a8 8 0 0 1 1-2.3l-1.2-2 1.4-1.4 2 1.2a8 8 0 0 1 2.3-1L11 2z"/>
                                <TextBlock x:Name="textNavPengaturan" Text="Pengaturan" FontSize="13" Foreground="#374151" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Bottom Section (Plain user info + quiet logout link) -->
                <StackPanel Grid.Row="2">
                    <StackPanel Margin="10,0,10,12">
                        <TextBlock x:Name="txtSidebarUsername" Text="user1" FontSize="12.5" FontWeight="SemiBold" Foreground="#111827"/>
                        <TextBlock x:Name="txtSidebarRole" Text="Pengguna Utama" FontSize="11" Foreground="#52525B" Margin="0,1,0,0"/>
                    </StackPanel>

                    <Button x:Name="btnLogout" Click="btnLogout_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="6" Background="Transparent" BorderThickness="0" Padding="10,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="13" Height="13" Stretch="Uniform" Fill="#374151" Margin="0,0,10,0" VerticalAlignment="Center"
                                              Data="M9 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4v-2H5V5h4V3zm7.6 4.6L15.2 9l2.8 2.8H9v2h9l-2.8 2.8 1.4 1.4 5.2-5.2-5.2-4.8z"/>
                                        <TextBlock Text="Keluar" Foreground="#374151" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area (Pure White) -->
        <Grid Grid.Column="1" Background="#FFFFFF">
            <!-- ================= VIEW 1: DASHBOARD ================= -->
            <ScrollViewer x:Name="panelDashboard" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,26">
                    <!-- Header + City Controls -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Ringkasan" FontSize="22" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="cbDashboardCity" Width="136" Margin="0,0,8,0" SelectionChanged="cbDashboardCity_SelectionChanged"/>

                            <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38" Width="156" Margin="0,0,6,0">
                                <Grid>
                                    <TextBlock Text="Cari kota..." Foreground="#6B7280" FontSize="12" Padding="12,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=tbCitySearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="tbCitySearch" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                             Padding="12,0" VerticalContentAlignment="Center" FontSize="12" CaretBrush="#111827"
                                             ToolTip="Ketik nama kota Indonesia lalu tekan Cari"
                                             KeyDown="tbCitySearch_KeyDown"/>
                                </Grid>
                            </Border>

                            <Button x:Name="btnSearchCity" Click="btnSearchCity_Click" Cursor="Hand" Height="38" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Padding="14,0">
                                            <TextBlock Text="Cari" Foreground="#111827" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="btnRefreshApi" Click="btnRefreshApi_Click" Cursor="Hand" Height="38">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Background="#0F766E" BorderThickness="0" Padding="14,0">
                                            <TextBlock x:Name="txtBtnRefreshApi" Text="Refresh" Foreground="White" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Dynamic Pollution Alert Banner -->
                    <Border x:Name="bannerPollutionAlert" Visibility="Collapsed" CornerRadius="6"
                            Background="#F4F6F8" BorderBrush="#0F766E" BorderThickness="3,0,0,0" Padding="16,12" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtBannerAlertTitle" Text="Peringatan Polusi" FontSize="13" FontWeight="SemiBold" Foreground="#111827"/>
                                <TextBlock x:Name="txtBannerAlertBody" Text="AQI melebihi ambang batas aman." FontSize="12" Foreground="#374151" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="btnBannerAdvice" Grid.Column="1" Click="btnBannerAdvice_Click" Cursor="Hand" Height="32" Margin="14,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Padding="12,0">
                                            <TextBlock Text="Detail" Foreground="#111827" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Single High-Contrast KPI Strip -->
                    <Border CornerRadius="8" Background="#F4F6F8" BorderThickness="0" Padding="22,18" Margin="0,0,0,22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- KPI 1: AQI -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="AQI" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,3">
                                    <TextBlock x:Name="txtDashboardAqi" Text="--" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                                    <TextBlock x:Name="txtDashboardAqiSub" Text=" Memuat" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F766E" VerticalAlignment="Bottom" Margin="7,0,0,5"/>
                                </StackPanel>
                                <TextBlock x:Name="txtDashboardPollutant" Text="--" FontSize="11.5" Foreground="#52525B"/>
                            </StackPanel>

                            <!-- KPI 2: Total Emisi -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Total Emisi" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151"/>
                                <TextBlock x:Name="txtDashboardTotalEmisi" Text="0.0 kg CO₂" FontSize="24" FontWeight="Bold" Foreground="#111827" Margin="0,8,0,5"/>
                                <TextBlock x:Name="txtDashboardLogCount" Text="0 catatan" FontSize="11.5" Foreground="#52525B"/>
                            </StackPanel>

                            <!-- KPI 3: Angin -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Angin" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,3">
                                    <TextBlock x:Name="txtDashboardAngin" Text="--" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                                    <TextBlock Text=" km/h" FontSize="12.5" Foreground="#374151" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                                </StackPanel>
                                <TextBlock x:Name="txtDashboardWeatherSub" Text="--°C • --%" FontSize="11.5" Foreground="#52525B"/>
                            </StackPanel>

                            <!-- KPI 4: Status -->
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Status" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151"/>
                                <TextBlock x:Name="txtDashboardStatus" Text="--" FontSize="24" FontWeight="Bold" Foreground="#0F766E" Margin="0,8,0,5"/>
                                <TextBlock x:Name="txtDashboardStatusSub" Text="Yogyakarta" FontSize="11.5" Foreground="#52525B"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Dynamic 24-Hour AQI Chart (Directly on White Canvas) -->
                    <Grid Height="250" Margin="0,0,0,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock x:Name="txtChartTitle" Text="Tren AQI 24 Jam" FontSize="14.5" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtChartSummary" Text="Min: -- • Rata-rata: -- • Puncak: --" FontSize="12" Foreground="#52525B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <!-- Y Axis Ticks -->
                            <Grid Margin="0,4,0,24" Width="32" HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" x:Name="txtYAxisMax" Text="200" Foreground="#52525B" FontSize="10.5" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="1" x:Name="txtYAxisHigh" Text="150" Foreground="#52525B" FontSize="10.5" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="2" x:Name="txtYAxisMid" Text="100" Foreground="#52525B" FontSize="10.5" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="3" x:Name="txtYAxisLow" Text="50" Foreground="#52525B" FontSize="10.5" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="4" x:Name="txtYAxisZero" Text="0" Foreground="#52525B" FontSize="10.5" VerticalAlignment="Bottom"/>
                            </Grid>

                            <!-- Exact Coordinate Canvas inside Viewbox -->
                            <Viewbox Margin="36,10,10,24" Stretch="Fill">
                                <Canvas Width="800" Height="190">
                                    <Line X1="0" Y1="0" X2="800" Y2="0" Stroke="#E5E7EB" StrokeThickness="1" StrokeDashArray="4 4"/>
                                    <Line X1="0" Y1="47.5" X2="800" Y2="47.5" Stroke="#E5E7EB" StrokeThickness="1" StrokeDashArray="4 4"/>
                                    <Line X1="0" Y1="95" X2="800" Y2="95" Stroke="#E5E7EB" StrokeThickness="1" StrokeDashArray="4 4"/>
                                    <Line X1="0" Y1="142.5" X2="800" Y2="142.5" Stroke="#E5E7EB" StrokeThickness="1" StrokeDashArray="4 4"/>
                                    <Line X1="0" Y1="190" X2="800" Y2="190" Stroke="#D1D5DB" StrokeThickness="1"/>

                                    <Path x:Name="pathChartFill">
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#240F766E" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                    </Path>

                                    <Path x:Name="pathChartStroke" Stroke="#0F766E" StrokeThickness="2.2"/>
                                    <Canvas x:Name="canvasChartDots"/>
                                </Canvas>
                            </Viewbox>

                            <!-- Evenly Spaced X Axis Time Labels (0%, 20%, 40%, 60%, 80%, 100%) -->
                            <Grid VerticalAlignment="Bottom" Margin="36,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="txtXAxis0" Text="00:00" Foreground="#52525B" FontSize="10.5" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" x:Name="txtXAxis1" Text="04:00" Foreground="#52525B" FontSize="10.5" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="txtXAxis2" Text="08:00" Foreground="#52525B" FontSize="10.5" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" x:Name="txtXAxis3" Text="12:00" Foreground="#52525B" FontSize="10.5" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" x:Name="txtXAxis4" Text="16:00" Foreground="#52525B" FontSize="10.5" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" x:Name="txtXAxis5" Text="20:00" Foreground="#52525B" FontSize="10.5" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Pollutants & Smart Recommendation (Hairline section divider) -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Polutan -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Polutan" FontSize="14.5" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="6" Background="#F4F6F8" BorderThickness="0" Padding="12,11">
                                        <StackPanel>
                                            <TextBlock Text="PM2.5" FontSize="11" FontWeight="SemiBold" Foreground="#374151"/>
                                            <TextBlock x:Name="txtPolPm25" Text="--" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,1"/>
                                            <TextBlock Text="µg/m³" FontSize="10" Foreground="#52525B"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" CornerRadius="6" Background="#F4F6F8" BorderThickness="0" Padding="12,11">
                                        <StackPanel>
                                            <TextBlock Text="PM10" FontSize="11" FontWeight="SemiBold" Foreground="#374151"/>
                                            <TextBlock x:Name="txtPolPm10" Text="--" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,1"/>
                                            <TextBlock Text="µg/m³" FontSize="10" Foreground="#52525B"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" CornerRadius="6" Background="#F4F6F8" BorderThickness="0" Padding="12,11">
                                        <StackPanel>
                                            <TextBlock Text="CO" FontSize="11" FontWeight="SemiBold" Foreground="#374151"/>
                                            <TextBlock x:Name="txtPolCo" Text="--" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,1"/>
                                            <TextBlock Text="µg/m³" FontSize="10" Foreground="#52525B"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="6" CornerRadius="6" Background="#F4F6F8" BorderThickness="0" Padding="12,11">
                                        <StackPanel>
                                            <TextBlock Text="NO₂" FontSize="11" FontWeight="SemiBold" Foreground="#374151"/>
                                            <TextBlock x:Name="txtPolNo2" Text="--" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,1"/>
                                            <TextBlock Text="µg/m³" FontSize="10" Foreground="#52525B"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="8" CornerRadius="6" Background="#F4F6F8" BorderThickness="0" Padding="12,11">
                                        <StackPanel>
                                            <TextBlock Text="O₃" FontSize="11" FontWeight="SemiBold" Foreground="#374151"/>
                                            <TextBlock x:Name="txtPolO3" Text="--" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,4,0,1"/>
                                            <TextBlock Text="µg/m³" FontSize="10" Foreground="#52525B"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- Right: Rekomendasi -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Rekomendasi" FontSize="14.5" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,10"/>
                                <TextBlock x:Name="txtRecommendation" Text="Memuat..."
                                           FontSize="12.5" Foreground="#374151" TextWrapping="Wrap" LineHeight="20"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= VIEW 2: PETA AQI ================= -->
            <ScrollViewer x:Name="panelPetaAqi" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,26">
                    <Grid Margin="0,0,0,18">
                        <TextBlock Text="Peta AQI" FontSize="22" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>

                        <Button x:Name="btnRefreshMap" HorizontalAlignment="Right" Click="btnRefreshMap_Click" Cursor="Hand" Height="36">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Padding="14,0">
                                        <TextBlock Text="Muat Ulang" Foreground="#111827" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Interactive Map Container -->
                    <Border CornerRadius="8" Background="#EDF2F7" BorderThickness="0" Height="395" ClipToBounds="True">
                        <Viewbox Stretch="Uniform">
                            <Grid Width="1030" Height="515">
                                <Image Source="pack://application:,,,/map_indonesia_clean.png" Stretch="Fill"/>
                                <Canvas x:Name="canvasMapPins" Width="1030" Height="515"/>
                            </Grid>
                        </Viewbox>
                    </Border>

                    <!-- Monochromatic Single-Hue AQI Legend -->
                    <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,14">
                        <StackPanel Orientation="Horizontal" Margin="10,2">
                            <Ellipse Width="9" Height="9" Fill="#D1ECE7" Stroke="#0F766E" StrokeThickness="1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="0-50 Baik" FontSize="11.5" Foreground="#374151"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,2">
                            <Ellipse Width="9" Height="9" Fill="#0F766E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="51-100 Sedang" FontSize="11.5" Foreground="#374151"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,2">
                            <Ellipse Width="9" Height="9" Fill="#115E59" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="101-150 Sensitif" FontSize="11.5" Foreground="#374151"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,2">
                            <Ellipse Width="9" Height="9" Fill="#134E4A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="151-200 Tidak Sehat" FontSize="11.5" Foreground="#374151"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="10,2">
                            <Ellipse Width="9" Height="9" Fill="#111827" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="&gt;200 Berbahaya" FontSize="11.5" Foreground="#374151"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Selected Station Detail Band -->
                    <Border x:Name="cardSelectedStation" CornerRadius="8" Background="#F4F6F8" BorderThickness="0" Padding="18,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="borderStationBadge" Grid.Column="0" Width="54" Height="54" CornerRadius="6" Background="#0F766E" BorderThickness="0" Margin="0,0,16,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="txtStationAqi" Text="--" FontSize="19" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtStationAqiLabel" Text="AQI" FontSize="9.5" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="txtStationTitle" Text="Pilih Stasiun" FontSize="15" FontWeight="Bold" Foreground="#111827"/>
                                    <TextBlock x:Name="txtStationProvince" Text="" FontSize="12" Foreground="#52525B" VerticalAlignment="Bottom" Margin="8,0,0,1"/>
                                    <TextBlock x:Name="txtStationCategory" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#0F766E" VerticalAlignment="Bottom" Margin="10,0,0,1"/>
                                </StackPanel>
                                <TextBlock x:Name="txtStationMetrics" Text="PM2.5: -- • PM10: -- • Suhu: -- • Angin: -- • Kelembapan: --" FontSize="12" FontWeight="SemiBold" Foreground="#111827" Margin="0,4,0,2"/>
                                <TextBlock x:Name="txtStationAdvice" Text="" FontSize="12" Foreground="#374151" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button x:Name="btnMonitorStation" Grid.Column="2" Click="btnMonitorStation_Click" Cursor="Hand" Height="36" VerticalAlignment="Center" Margin="14,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Background="#0F766E" BorderThickness="0" Padding="16,0">
                                            <TextBlock Text="Pantau" Foreground="White" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= VIEW 3: LOG ENERGI ================= -->
            <ScrollViewer x:Name="panelLogEnergi" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,26">
                    <Grid Margin="0,0,0,22">
                        <TextBlock Text="Log Energi" FontSize="22" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>

                        <!-- Admin User Switcher -->
                        <StackPanel x:Name="panelAdminUserSwitcher" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Text="Pengguna" Foreground="#374151" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cbActiveUser" Width="130" Height="34" SelectionChanged="cbActiveUser_SelectionChanged"/>
                        </StackPanel>

                        <!-- Regular User Badge -->
                        <Border x:Name="borderRegularUserBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                CornerRadius="6" Background="#F4F6F8" BorderThickness="0" Padding="12,7">
                            <TextBlock x:Name="txtLogUserBadge" Text="user2" FontWeight="SemiBold" Foreground="#111827" FontSize="12" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Input / Edit Konsumsi -->
                        <Border Grid.Column="0" CornerRadius="8" Background="#F4F6F8" BorderThickness="0" Padding="20,18" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock x:Name="txtFormModeTitle" Text="Input Konsumsi" FontSize="15" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,16"/>

                                <TextBlock Text="Jenis Energi" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="borderEnergyListrik" Grid.Column="0" CornerRadius="6" Background="#0F766E" BorderThickness="0" Height="36" Cursor="Hand" MouseLeftButtonDown="SelectEnergyListrik_Click">
                                        <TextBlock x:Name="txtEnergyListrik" Text="Listrik" Foreground="White" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <Border x:Name="borderEnergyBbm" Grid.Column="2" CornerRadius="6" Background="#E2E7EC" BorderThickness="0" Height="36" Cursor="Hand" MouseLeftButtonDown="SelectEnergyBbm_Click">
                                        <TextBlock x:Name="txtEnergyBbm" Text="BBM" Foreground="#111827" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="lblSatuanKonsumsi" Text="Jumlah (kWh)" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                                <Border CornerRadius="6" Background="#FFFFFF" BorderThickness="0" Height="38" Margin="0,0,0,6">
                                    <TextBox x:Name="tbJumlahKonsumsi" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                             Padding="12,0" VerticalContentAlignment="Center" FontSize="13" Text="10" CaretBrush="#111827"
                                             TextChanged="tbJumlahKonsumsi_TextChanged"/>
                                </Border>
                                <TextBlock x:Name="txtLiveCo2Preview" Text="Estimasi: +8.50 kg CO₂" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,0,0,14"/>

                                <TextBlock Text="Tanggal (YYYY-MM-DD)" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                                <Border CornerRadius="6" Background="#FFFFFF" BorderThickness="0" Height="38" Margin="0,0,0,18">
                                    <TextBox x:Name="tbTanggalKonsumsi" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                             Padding="12,0" VerticalContentAlignment="Center" FontSize="13" CaretBrush="#111827"/>
                                </Border>

                                <Button x:Name="btnCatatJejak" Height="40" Cursor="Hand" Click="btnCatatJejak_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="6" Background="#0F766E" BorderThickness="0">
                                                <TextBlock x:Name="txtBtnCatatJejak" Text="+ Catat Jejak" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="btnCancelEdit" Visibility="Collapsed" Height="36" Cursor="Hand" Click="btnCancelEdit_Click" Margin="0,8,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="6" Background="#E2E7EC" BorderThickness="0">
                                                <TextBlock Text="Batal Edit" Foreground="#111827" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Right Column: Riwayat Ledger (Directly on White Canvas) -->
                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Riwayat" FontSize="15" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtTotalEmisiSummary" Text="Total: 0.0 kg CO₂" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#0F766E" FontWeight="SemiBold" FontSize="12.5"/>
                            </Grid>

                            <!-- Underline Filter Tabs & Neutral Export -->
                            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,4">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Border x:Name="borderFilterAll" BorderBrush="#0F766E" BorderThickness="0,0,0,2" Padding="2,6,2,6" Margin="0,0,18,0" Cursor="Hand" MouseLeftButtonDown="FilterAll_Click">
                                            <TextBlock x:Name="txtFilterAll" Text="Semua" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F766E"/>
                                        </Border>
                                        <Border x:Name="borderFilterListrik" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="2,6,2,6" Margin="0,0,18,0" Cursor="Hand" MouseLeftButtonDown="FilterListrik_Click">
                                            <TextBlock x:Name="txtFilterListrik" Text="Listrik" FontSize="12.5" Foreground="#52525B"/>
                                        </Border>
                                        <Border x:Name="borderFilterBbm" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="2,6,2,6" Cursor="Hand" MouseLeftButtonDown="FilterBbm_Click">
                                            <TextBlock x:Name="txtFilterBbm" Text="BBM" FontSize="12.5" Foreground="#52525B"/>
                                        </Border>
                                    </StackPanel>

                                    <Button x:Name="btnExportCsv" HorizontalAlignment="Right" Click="btnExportCsv_Click" Cursor="Hand" Height="30">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Padding="12,0">
                                                    <TextBlock Text="Ekspor CSV" FontSize="12" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="panelDaftarEmisi"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= VIEW 4: PENGATURAN (Clean Editorial Columns) ================= -->
            <ScrollViewer x:Name="panelPengaturan" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,26">
                    <TextBlock Text="Pengaturan" FontSize="22" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,22"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 1: Profil & Ubah Password -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Profil" FontSize="15" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,14"/>

                            <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38" Margin="0,0,0,12" Padding="12,0">
                                <TextBlock x:Name="txtPengaturanUsername" Text="user1" Foreground="#111827" VerticalAlignment="Center" FontSize="13"/>
                            </Border>

                            <TextBlock Text="Peran" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38" Margin="0,0,0,12" Padding="12,0">
                                <TextBlock x:Name="txtPengaturanRole" Text="Pengguna Utama" Foreground="#0F766E" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13"/>
                            </Border>

                            <TextBlock Text="Email" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38" Margin="0,0,0,12">
                                <TextBox x:Name="tbPengaturanEmail" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="13" CaretBrush="#111827"/>
                            </Border>

                            <TextBlock Text="Kota Default" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cbPengaturanCity"/>

                            <Border Height="1" Background="#E5E7EB" Margin="0,22,0,18"/>

                            <TextBlock Text="Ubah Password" FontSize="15" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,14"/>

                            <TextBlock Text="Password Lama" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38" Margin="0,0,0,10">
                                <PasswordBox x:Name="tbOldPassword" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                             Padding="12,0" VerticalContentAlignment="Center" FontSize="12.5" CaretBrush="#111827"/>
                            </Border>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Password Baru" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                                    <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38">
                                        <PasswordBox x:Name="tbNewPassword" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                                     Padding="12,0" VerticalContentAlignment="Center" FontSize="12.5" CaretBrush="#111827"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Konfirmasi" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                                    <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38">
                                        <PasswordBox x:Name="tbConfirmNewPassword" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                                     Padding="12,0" VerticalContentAlignment="Center" FontSize="12.5" CaretBrush="#111827"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Button x:Name="btnChangePassword" Click="btnChangePassword_Click" Cursor="Hand" Height="38">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0">
                                            <TextBlock Text="Ubah Password" Foreground="#111827" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Column 2: Preferensi & Database -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Preferensi" FontSize="15" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,14"/>

                            <TextBlock Text="Satuan Emisi" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cbEmissionUnit" Margin="0,0,0,12">
                                <ComboBoxItem Content="kg CO₂" Tag="kg"/>
                                <ComboBoxItem Content="ton CO₂" Tag="ton"/>
                            </ComboBox>

                            <TextBlock Text="Interval Refresh" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <ComboBox x:Name="cbAutoRefresh" Margin="0,0,0,14">
                                <ComboBoxItem Content="Manual" Tag="0"/>
                                <ComboBoxItem Content="Setiap 5 Menit" Tag="5"/>
                                <ComboBoxItem Content="Setiap 15 Menit" Tag="15"/>
                                <ComboBoxItem Content="Setiap 30 Menit" Tag="30"/>
                            </ComboBox>

                            <CheckBox x:Name="chkEnableAlerts" Content="Notifikasi Polusi Desktop" IsChecked="True" Margin="0,0,0,12"/>

                            <TextBlock Text="Ambang Batas AQI" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38" Margin="0,0,0,14">
                                <TextBox x:Name="tbAlertThreshold" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="13" Text="100" CaretBrush="#111827"/>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnTestApi" Grid.Column="0" Click="btnTestApi_Click" Cursor="Hand" Height="36">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0">
                                                <TextBlock Text="Tes API" Foreground="#111827" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="btnTestAlert" Grid.Column="2" Click="btnTestAlert_Click" Cursor="Hand" Height="36">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0">
                                                <TextBlock Text="Uji Notifikasi" Foreground="#111827" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <Border Height="1" Background="#E5E7EB" Margin="0,22,0,18"/>

                            <TextBlock Text="Database" FontSize="15" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,22">
                                <TextBlock x:Name="txtSettingsDbInfo" Text="SQLite (carbonair.db)" FontSize="12.5" Foreground="#52525B" VerticalAlignment="Center"/>
                                <Button x:Name="btnSettingsDbConfig" HorizontalAlignment="Right" Click="btnSettingsDbConfig_Click" Cursor="Hand" Height="34">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Padding="14,0">
                                                <TextBlock Text="Atur" Foreground="#111827" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <Button x:Name="btnSaveSettings" Height="40" Cursor="Hand" Click="btnSaveSettings_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Background="#0F766E" BorderThickness="0">
                                            <TextBlock Text="Simpan Pengaturan" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
