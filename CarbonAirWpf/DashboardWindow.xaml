<Window x:Class="CarbonAirWpf.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CarbonAir - Dashboard" Height="740" Width="1140"
        MinHeight="660" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#0B1317">
    <Grid Background="#0B1317">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0C151A" BorderBrush="#16242B" BorderThickness="0,0,1,0">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,28">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#00B4D8" Margin="0,0,10,0">
                        <Path Width="18" Height="18" Stretch="Uniform" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z"/>
                    </Border>
                    <TextBlock Text="CarbonAir" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1">
                    <!-- Nav 1: Dashboard -->
                    <Border x:Name="borderNavDashboard" CornerRadius="8" Background="#142630" BorderBrush="#00B4D8" BorderThickness="1" Height="40" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="NavDashboard_Click">
                        <StackPanel Orientation="Horizontal" Margin="14,0">
                            <Path x:Name="iconNavDashboard" Width="14" Height="14" Stretch="Uniform" Fill="#00E5FF" Margin="0,0,12,0" VerticalAlignment="Center"
                                  Data="M3 3h8v8H3V3zm10 0h8v5h-8V3zm0 7h8v11h-8V10zM3 13h8v8H3v-8z"/>
                            <TextBlock x:Name="textNavDashboard" Text="Dashboard" FontWeight="SemiBold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Nav 2: Peta AQI -->
                    <Border x:Name="borderNavPetaAqi" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Height="40" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="NavPetaAqi_Click">
                        <StackPanel Orientation="Horizontal" Margin="14,0">
                            <Path x:Name="iconNavPetaAqi" Width="14" Height="14" Stretch="Uniform" Fill="#8E9FA8" Margin="0,0,12,0" VerticalAlignment="Center"
                                  Data="M9 3L3 6v15l6-3 6 3 6-3V3l-6 3-6-3zm1 3.5l4 2v10l-4-2v-10z"/>
                            <TextBlock x:Name="textNavPetaAqi" Text="Peta AQI" Foreground="#8E9FA8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Nav 3: Log Energi -->
                    <Border x:Name="borderNavLogEnergi" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Height="40" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="NavLogEnergi_Click">
                        <StackPanel Orientation="Horizontal" Margin="14,0">
                            <Path x:Name="iconNavLogEnergi" Width="14" Height="14" Stretch="Uniform" Fill="#8E9FA8" Margin="0,0,12,0" VerticalAlignment="Center"
                                  Data="M3 3v18h18v-2H5V3H3zm4 11l4-4 4 4 6-7-1.4-1.4-4.6 5.4-4-4-5.4 5.4L7 14z"/>
                            <TextBlock x:Name="textNavLogEnergi" Text="Log Energi" Foreground="#8E9FA8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Nav 4: Pengaturan -->
                    <Border x:Name="borderNavPengaturan" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Height="40" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="NavPengaturan_Click">
                        <StackPanel Orientation="Horizontal" Margin="14,0">
                            <Path x:Name="iconNavPengaturan" Width="14" Height="14" Stretch="Uniform" Fill="#8E9FA8" Margin="0,0,12,0" VerticalAlignment="Center"
                                  Data="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm-1-6h2l.7 2.2a8 8 0 0 1 2.3 1l2-1.2 1.4 1.4-1.2 2a8 8 0 0 1 1 2.3L22 11v2l-2.2.7a8 8 0 0 1-1 2.3l1.2 2-1.4 1.4-2-1.2a8 8 0 0 1-2.3 1L13 22h-2l-.7-2.2a8 8 0 0 1-2.3-1l-2 1.2-1.4-1.4 1.2-2a8 8 0 0 1-1-2.3L2 13v-2l2.2-.7a8 8 0 0 1 1-2.3l-1.2-2 1.4-1.4 2 1.2a8 8 0 0 1 2.3-1L11 2z"/>
                            <TextBlock x:Name="textNavPengaturan" Text="Pengaturan" Foreground="#8E9FA8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Bottom Section -->
                <StackPanel Grid.Row="2">
                    <Border CornerRadius="8" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="12,9" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#142630" Margin="0,0,9,0">
                                <Path Width="11" Height="11" Stretch="Uniform" Fill="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm-6 14a6 6 0 0 1 12 0v1H6v-1z"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="txtSidebarUsername" Text="user1" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="txtSidebarRole" Text="Pengguna Utama" FontSize="9.5" Foreground="#00D2FF"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button x:Name="btnLogout" Click="btnLogout_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8" Background="#161A1D" Padding="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="#FF5252" Margin="0,0,10,0" VerticalAlignment="Center"
                                              Data="M9 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4v-2H5V5h4V3zm7.6 4.6L15.2 9l2.8 2.8H9v2h9l-2.8 2.8 1.4 1.4 5.2-5.2-5.2-4.8z"/>
                                        <TextBlock Text="Keluar" Foreground="#FF5252" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border CornerRadius="8" Background="#10181C" Padding="10,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CarbonAir MVP v1.0" FontSize="10" Foreground="#5A6D77" HorizontalAlignment="Center"/>
                            <TextBlock Text="© 2026 Kelompok AB to Z" FontSize="9.5" Foreground="#5A6D77" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <!-- ================= VIEW 1: DASHBOARD ================= -->
            <ScrollViewer x:Name="panelDashboard" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22">
                    <!-- Header + City Controls + API Status -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ringkasan Hari Ini" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Pantau kualitas udara real-time via Web REST API &amp; jejak karbon Anda." FontSize="12.5" Foreground="#8E9FA8" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="cbDashboardCity" Width="138" Margin="0,0,8,0" SelectionChanged="cbDashboardCity_SelectionChanged"/>

                            <Border CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Height="38" Width="140" Margin="0,0,6,0">
                                <TextBox x:Name="tbCitySearch" Background="Transparent" Foreground="White" BorderThickness="0"
                                         Padding="10,0" VerticalContentAlignment="Center" FontSize="12" CaretBrush="White"
                                         ToolTip="Ketik nama kota lalu tekan Cari (Open-Meteo Geocoding API)"
                                         KeyDown="tbCitySearch_KeyDown"/>
                            </Border>

                            <Button x:Name="btnSearchCity" Click="btnSearchCity_Click" Cursor="Hand" Height="38" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" Background="#142630" BorderBrush="#00B4D8" BorderThickness="1" Padding="12,0">
                                            <TextBlock Text="Cari Kota" Foreground="#00E5FF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="btnRefreshApi" Click="btnRefreshApi_Click" Cursor="Hand" Height="38" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8" Padding="12,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00D2FF" Offset="0"/>
                                                    <GradientStop Color="#007BFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="Refresh API" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Border x:Name="borderApiStatus" CornerRadius="8" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Height="38" Padding="10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="dotApiStatus" Width="8" Height="8" Fill="#F1C40F" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtApiStatus" Text="Memuat API..." FontSize="11" Foreground="#A0B2BC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Dynamic Pollution Alert Banner -->
                    <Border x:Name="bannerPollutionAlert" Visibility="Collapsed" CornerRadius="10"
                            Background="#2A1414" BorderBrush="#E74C3C" BorderThickness="1" Padding="16,12" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform" Fill="#FF6B6B" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="txtBannerAlertTitle" Text="Peringatan Kualitas Udara" FontSize="13" FontWeight="Bold" Foreground="#FF8787"/>
                                <TextBlock x:Name="txtBannerAlertBody" Text="AQI melebihi ambang batas aman." FontSize="11.5" Foreground="#E6C7C7" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="btnBannerAdvice" Grid.Column="2" Click="btnBannerAdvice_Click" Cursor="Hand" Height="32" Margin="12,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Background="#3D1C1C" BorderBrush="#FF6B6B" BorderThickness="1" Padding="12,0">
                                            <TextBlock Text="Lihat Notifikasi" Foreground="#FF8787" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 4 Live Stat Cards -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: AQI Saat Ini -->
                        <Border Grid.Column="0" CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="6" Background="#262316" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Width="14" Height="14" Stretch="Uniform" Fill="#F1C40F" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/>
                                </Border>
                                <TextBlock Text="AQI Saat Ini (US AQI)" FontSize="11" Foreground="#8E9FA8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,2">
                                    <TextBlock x:Name="txtDashboardAqi" Text="--" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="txtDashboardAqiSub" Text=" Memuat" FontSize="11.5" FontWeight="SemiBold" Foreground="#2ECC71" VerticalAlignment="Bottom" Margin="5,0,0,3"/>
                                </StackPanel>
                                <TextBlock x:Name="txtDashboardPollutant" Text="Polutan utama: --" FontSize="10.5" Foreground="#657984"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Total Emisi Anda -->
                        <Border Grid.Column="2" CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="6" Background="#122730" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Width="13" Height="13" Stretch="Uniform" Fill="#00D2FF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M7 2v11h3v9l7-12h-4l4-8z"/>
                                </Border>
                                <TextBlock Text="Total Emisi Anda" FontSize="11" Foreground="#8E9FA8"/>
                                <TextBlock x:Name="txtDashboardTotalEmisi" Text="0.0 kg CO₂" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,5,0,2"/>
                                <TextBlock x:Name="txtDashboardLogCount" Text="0 catatan tercatat" FontSize="10.5" Foreground="#657984"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Cuaca & Angin -->
                        <Border Grid.Column="4" CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="6" Background="#162533" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Width="14" Height="14" Stretch="Uniform" Fill="#3498DB" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M14.5 17c0 1.65-1.35 3-3 3s-3-1.35-3-3h2c0 .55.45 1 1 1s1-.45 1-1-.45-1-1-1H2v-2h9.5c1.65 0 3 1.35 3 3zm4.5-8c0-1.65-1.35-3-3-3s-3 1.35-3 3h2c0-.55.45-1 1-1s1 .45 1 1-.45 1-1 1H2v2h14c1.65 0 3-1.35 3-3zm-2.5 3c-1.65 0-3 1.35-3 3h2c0 .55.45 1 1 1s1-.45 1-1-.45-1-1-1zm3.5-3H2v2h17.5c.55 0 1-.45 1-1s-.45-1-1-1z"/>
                                </Border>
                                <TextBlock Text="Kecepatan Angin &amp; Cuaca" FontSize="11" Foreground="#8E9FA8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,2">
                                    <TextBlock x:Name="txtDashboardAngin" Text="--" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text=" km/h" FontSize="12" Foreground="#8E9FA8" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                                </StackPanel>
                                <TextBlock x:Name="txtDashboardWeatherSub" Text="--°C • Lembap --%" FontSize="10.5" Foreground="#657984"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Status Polusi -->
                        <Border Grid.Column="6" CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <Border Width="28" Height="28" CornerRadius="6" Background="#142820" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Path Width="14" Height="14" Stretch="Uniform" Fill="#2ECC71" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M3 13h4l3-8 4 16 3-8h4v-2h-5l-2 5-4-16-4 11H3v2z"/>
                                </Border>
                                <TextBlock Text="Status Polusi" FontSize="11" Foreground="#8E9FA8"/>
                                <TextBlock x:Name="txtDashboardStatus" Text="--" FontSize="21" FontWeight="Bold" Foreground="#2ECC71" Margin="0,5,0,2"/>
                                <TextBlock x:Name="txtDashboardStatusSub" Text="di Yogyakarta" FontSize="10.5" Foreground="#8E9FA8"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Dynamic 24-Hour AQI Chart -->
                    <Border CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="22,18" Height="285" Margin="0,0,0,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock x:Name="txtChartTitle" Text="Tren Kualitas Udara (AQI) - 24 Jam Terakhir" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtChartSummary" Text="Min: -- • Rata-rata: -- • Puncak: --" FontSize="11.5" Foreground="#00D2FF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <!-- Y Axis Ticks -->
                                <Grid Margin="0,4,0,24" Width="30" HorizontalAlignment="Left">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" x:Name="txtYAxisMax" Text="200" Foreground="#5A6D77" FontSize="10" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Row="1" x:Name="txtYAxisHigh" Text="150" Foreground="#5A6D77" FontSize="10" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Row="2" x:Name="txtYAxisMid" Text="100" Foreground="#5A6D77" FontSize="10" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Row="3" x:Name="txtYAxisLow" Text="50" Foreground="#5A6D77" FontSize="10" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Row="4" x:Name="txtYAxisZero" Text="0" Foreground="#5A6D77" FontSize="10" VerticalAlignment="Bottom"/>
                                </Grid>

                                <!-- Exact Coordinate Canvas inside Viewbox -->
                                <Viewbox Margin="36,10,10,24" Stretch="Fill">
                                    <Canvas Width="800" Height="190">
                                        <Line X1="0" Y1="0" X2="800" Y2="0" Stroke="#2A3E48" StrokeThickness="1" StrokeDashArray="4 4"/>
                                        <Line X1="0" Y1="47.5" X2="800" Y2="47.5" Stroke="#2A3E48" StrokeThickness="1" StrokeDashArray="4 4"/>
                                        <Line X1="0" Y1="95" X2="800" Y2="95" Stroke="#2A3E48" StrokeThickness="1" StrokeDashArray="4 4"/>
                                        <Line X1="0" Y1="142.5" X2="800" Y2="142.5" Stroke="#2A3E48" StrokeThickness="1" StrokeDashArray="4 4"/>
                                        <Line X1="0" Y1="190" X2="800" Y2="190" Stroke="#2A3E48" StrokeThickness="1"/>

                                        <Path x:Name="pathChartFill">
                                            <Path.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#4500D2FF" Offset="0"/>
                                                    <GradientStop Color="#000B1317" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Path.Fill>
                                        </Path>

                                        <Path x:Name="pathChartStroke" Stroke="#00D2FF" StrokeThickness="2.5"/>
                                        <Canvas x:Name="canvasChartDots"/>
                                    </Canvas>
                                </Viewbox>

                                <!-- X Axis Time Labels -->
                                <Grid VerticalAlignment="Bottom" Margin="36,0,10,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="txtXAxis0" Text="00:00" Foreground="#5A6D77" FontSize="10"/>
                                    <TextBlock Grid.Column="1" x:Name="txtXAxis1" Text="04:00" Foreground="#5A6D77" FontSize="10"/>
                                    <TextBlock Grid.Column="2" x:Name="txtXAxis2" Text="08:00" Foreground="#5A6D77" FontSize="10"/>
                                    <TextBlock Grid.Column="3" x:Name="txtXAxis3" Text="12:00" Foreground="#5A6D77" FontSize="10"/>
                                    <TextBlock Grid.Column="4" x:Name="txtXAxis4" Text="16:00" Foreground="#5A6D77" FontSize="10"/>
                                    <TextBlock Grid.Column="5" x:Name="txtXAxis5" Text="20:00" Foreground="#5A6D77" FontSize="10" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Pollutants & Smart Recommendation -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Detail Polutan -->
                        <Border Grid.Column="0" CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Detail Konsentrasi Polutan (Open-Meteo API)" FontSize="13.5" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="PM2.5" FontSize="10" Foreground="#8E9FA8"/>
                                            <TextBlock x:Name="txtPolPm25" Text="--" FontSize="14" FontWeight="Bold" Foreground="#00E5FF" Margin="0,3,0,0"/>
                                            <TextBlock Text="µg/m³" FontSize="9.5" Foreground="#5A6D77"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="PM10" FontSize="10" Foreground="#8E9FA8"/>
