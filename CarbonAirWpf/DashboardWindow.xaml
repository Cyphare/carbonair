<Window x:Class="CarbonAirWpf.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CarbonAir - Dashboard" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0B1317">
    <Grid Background="#0B1317">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0C151A" BorderBrush="#16242B" BorderThickness="0,0,1,0">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,30">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#00B4D8" Margin="0,0,10,0">
                        <Path Width="18" Height="18" Stretch="Uniform" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z"/>
                    </Border>
                    <TextBlock Text="CarbonAir" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Menu (Vector Icons Only - No Emojis) -->
                <StackPanel Grid.Row="1">
                    <!-- Nav 1: Dashboard -->
                    <Border x:Name="borderNavDashboard" CornerRadius="8" Background="#142630" BorderBrush="#00B4D8" BorderThickness="1" Height="40" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="NavDashboard_Click">
                        <StackPanel Orientation="Horizontal" Margin="14,0">
                            <Path x:Name="iconNavDashboard" Width="14" Height="14" Stretch="Uniform" Fill="#00E5FF" Margin="0,0,12,0" VerticalAlignment="Center"
                                  Data="M3 3h8v8H3V3zm10 0h8v5h-8V3zm0 7h8v11h-8V10zM3 13h8v8H3v-8z"/>
                            <TextBlock x:Name="textNavDashboard" Text="Dashboard" FontWeight="SemiBold" Foreground="#00E5FF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Nav 2: Peta AQI -->
                    <Border x:Name="borderNavPetaAqi" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Height="40" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="NavPetaAqi_Click">
                        <StackPanel Orientation="Horizontal" Margin="14,0">
                            <Path x:Name="iconNavPetaAqi" Width="14" Height="14" Stretch="Uniform" Fill="#8E9FA8" Margin="0,0,12,0" VerticalAlignment="Center"
                                  Data="M9 3L3 6v15l6-3 6 3 6-3V3l-6 3-6-3zm1 3.5l4 2v10l-4-2v-10z"/>
                            <TextBlock x:Name="textNavPetaAqi" Text="Peta AQI" Foreground="#8E9FA8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Nav 3: Log Energi -->
                    <Border x:Name="borderNavLogEnergi" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Height="40" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="NavLogEnergi_Click">
                        <StackPanel Orientation="Horizontal" Margin="14,0">
                            <Path x:Name="iconNavLogEnergi" Width="14" Height="14" Stretch="Uniform" Fill="#8E9FA8" Margin="0,0,12,0" VerticalAlignment="Center"
                                  Data="M3 3v18h18v-2H5V3H3zm4 11l4-4 4 4 6-7-1.4-1.4-4.6 5.4-4-4-5.4 5.4L7 14z"/>
                            <TextBlock x:Name="textNavLogEnergi" Text="Log Energi" Foreground="#8E9FA8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Nav 4: Pengaturan -->
                    <Border x:Name="borderNavPengaturan" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Height="40" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="NavPengaturan_Click">
                        <StackPanel Orientation="Horizontal" Margin="14,0">
                            <Path x:Name="iconNavPengaturan" Width="14" Height="14" Stretch="Uniform" Fill="#8E9FA8" Margin="0,0,12,0" VerticalAlignment="Center"
                                  Data="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm-1-6h2l.7 2.2a8 8 0 0 1 2.3 1l2-1.2 1.4 1.4-1.2 2a8 8 0 0 1 1 2.3L22 11v2l-2.2.7a8 8 0 0 1-1 2.3l1.2 2-1.4 1.4-2-1.2a8 8 0 0 1-2.3 1L13 22h-2l-.7-2.2a8 8 0 0 1-2.3-1l-2 1.2-1.4-1.4 1.2-2a8 8 0 0 1-1-2.3L2 13v-2l2.2-.7a8 8 0 0 1 1-2.3l-1.2-2 1.4-1.4 2 1.2a8 8 0 0 1 2.3-1L11 2z"/>
                            <TextBlock x:Name="textNavPengaturan" Text="Pengaturan" Foreground="#8E9FA8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Bottom Section: User Info + Logout + Version -->
                <StackPanel Grid.Row="2">
                    <Border CornerRadius="8" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="12,8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24" Height="24" CornerRadius="12" Background="#142630" Margin="0,0,8,0">
                                <Path Width="10" Height="10" Stretch="Uniform" Fill="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm-6 14a6 6 0 0 1 12 0v1H6v-1z"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="User Aktif" FontSize="9.5" Foreground="#657984"/>
                                <TextBlock x:Name="txtSidebarUsername" Text="user1" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button x:Name="btnLogout" Click="btnLogout_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8" Background="#161A1D" Padding="12,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="#FF5252" Margin="0,0,10,0" VerticalAlignment="Center"
                                              Data="M9 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4v-2H5V5h4V3zm7.6 4.6L15.2 9l2.8 2.8H9v2h9l-2.8 2.8 1.4 1.4 5.2-5.2-5.2-4.8z"/>
                                        <TextBlock Text="Keluar" Foreground="#FF5252" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border CornerRadius="8" Background="#10181C" Padding="10,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CarbonAir Prototype v1.0" FontSize="10" Foreground="#5A6D77" HorizontalAlignment="Center"/>
                            <TextBlock Text="© 2026" FontSize="10" Foreground="#5A6D77" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area with View Panels -->
        <Grid Grid.Column="1">
            <!-- ================= VIEW 1: DASHBOARD ================= -->
            <ScrollViewer x:Name="panelDashboard" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,25">
                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Ringkasan Hari Ini" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Pantau kualitas udara dan jejak karbon Anda secara realtime." FontSize="13" Foreground="#8E9FA8" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 4 Stat Cards: N/A placeholders for sensor data -->
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: AQI Rata-rata -->
                        <Border Grid.Column="0" CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="18,16">
                            <StackPanel>
                                <Border Width="30" Height="30" CornerRadius="6" Background="#262316" HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <Path Width="15" Height="15" Stretch="Uniform" Fill="#F1C40F" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/>
                                </Border>
                                <TextBlock Text="AQI Rata-rata" FontSize="11" Foreground="#8E9FA8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock x:Name="txtDashboardAqi" Text="72" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="txtDashboardAqiSub" Text=" Baik" FontSize="12" FontWeight="SemiBold" Foreground="#2ECC71" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Total Emisi Anda -->
                        <Border Grid.Column="2" CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="18,16">
                            <StackPanel>
                                <Border Width="30" Height="30" CornerRadius="6" Background="#122730" HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <Path Width="14" Height="14" Stretch="Uniform" Fill="#00D2FF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M7 2v11h3v9l7-12h-4l4-8z"/>
                                </Border>
                                <TextBlock Text="Total Emisi Anda" FontSize="11" Foreground="#8E9FA8"/>
                                <TextBlock x:Name="txtDashboardTotalEmisi" Text="41.4 kg CO₂" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Kecepatan Angin -->
                        <Border Grid.Column="4" CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="18,16">
                            <StackPanel>
                                <Border Width="30" Height="30" CornerRadius="6" Background="#162533" HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <Path Width="15" Height="15" Stretch="Uniform" Fill="#3498DB" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M14.5 17c0 1.65-1.35 3-3 3s-3-1.35-3-3h2c0 .55.45 1 1 1s1-.45 1-1-.45-1-1-1H2v-2h9.5c1.65 0 3 1.35 3 3zm4.5-8c0-1.65-1.35-3-3-3s-3 1.35-3 3h2c0-.55.45-1 1-1s1 .45 1 1-.45 1-1 1H2v2h14c1.65 0 3-1.35 3-3zm-2.5 3c-1.65 0-3 1.35-3 3h2c0 .55.45 1 1 1s1-.45 1-1-.45-1-1-1zm3.5-3H2v2h17.5c.55 0 1-.45 1-1s-.45-1-1-1z"/>
                                </Border>
                                <TextBlock Text="Kecepatan Angin" FontSize="11" Foreground="#8E9FA8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock x:Name="txtDashboardAngin" Text="14" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text=" km/h" FontSize="12" Foreground="#8E9FA8" VerticalAlignment="Bottom" Margin="2,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Status Polusi -->
                        <Border Grid.Column="6" CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="18,16">
                            <StackPanel>
                                <Border Width="30" Height="30" CornerRadius="6" Background="#142820" HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <Path Width="15" Height="15" Stretch="Uniform" Fill="#2ECC71" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M3 13h4l3-8 4 16 3-8h4v-2h-5l-2 5-4-16-4 11H3v2z"/>
                                </Border>
                                <TextBlock Text="Status Polusi" FontSize="11" Foreground="#8E9FA8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock x:Name="txtDashboardStatus" Text="Aman" FontSize="22" FontWeight="Bold" Foreground="#2ECC71"/>
                                    <TextBlock x:Name="txtDashboardStatusSub" Text=" di lokasi Anda" FontSize="11" Foreground="#8E9FA8" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Rekomendasi & Notifikasi Polusi Banner (OOP Evaluasi AQI) -->
                    <Border x:Name="borderAqiAdvice" CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="18,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="iconAqiAdvice" Width="15" Height="15" Stretch="Uniform" Fill="#2ECC71" Margin="0,0,12,0" VerticalAlignment="Center"
                                      Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                                <TextBlock x:Name="txtAqiAdvice" Text="[CarbonAir Monitor] AQI 72 (Baik): Udara bersih, aman untuk aktivitas luar ruangan."
                                           Foreground="#D1DCE2" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="btnNotifikasiPolusi" Content="Kirim Notifikasi" Click="btnNotifikasiPolusi_Click"
                                    Background="#142630" Foreground="#00E5FF" BorderBrush="#00B4D8" BorderThickness="1"
                                    Padding="12,6" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Margin="14,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Chart Card Container -->
                    <Border CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="24,20" Height="285">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Tren Kualitas Udara (AQI) - 24 Jam Terakhir" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

                            <Grid Grid.Row="1">
                                <StackPanel VerticalAlignment="Stretch" Margin="0,5,0,25">
                                    <TextBlock Text="120" Foreground="#4A5A63" FontSize="10" Margin="0,0,0,32"/>
                                    <TextBlock Text="90" Foreground="#4A5A63" FontSize="10" Margin="0,0,0,32"/>
                                    <TextBlock Text="60" Foreground="#4A5A63" FontSize="10" Margin="0,0,0,32"/>
                                    <TextBlock Text="30" Foreground="#4A5A63" FontSize="10" Margin="0,0,0,32"/>
                                    <TextBlock Text="0" Foreground="#4A5A63" FontSize="10"/>
                                </StackPanel>

                                <!-- Chart Canvas and Smooth Curve Area -->
                                <Grid Margin="35,10,10,25">
                                    <Canvas Opacity="0.12">
                                        <Line X1="0" Y1="10" X2="780" Y2="10" Stroke="#4A5A63" StrokeThickness="1" StrokeDashArray="4 4"/>
                                        <Line X1="0" Y1="55" X2="780" Y2="55" Stroke="#4A5A63" StrokeThickness="1" StrokeDashArray="4 4"/>
                                        <Line X1="0" Y1="100" X2="780" Y2="100" Stroke="#4A5A63" StrokeThickness="1" StrokeDashArray="4 4"/>
                                        <Line X1="0" Y1="145" X2="780" Y2="145" Stroke="#4A5A63" StrokeThickness="1" StrokeDashArray="4 4"/>
                                        <Line X1="0" Y1="190" X2="780" Y2="190" Stroke="#4A5A63" StrokeThickness="1"/>
                                    </Canvas>

                                    <!-- Fill area under curve -->
                                    <Path x:Name="pathChartFill" Stretch="Fill">
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#4000D2FF" Offset="0"/>
                                                <GradientStop Color="#000B1317" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                    </Path>

                                    <!-- Curve stroke line -->
                                    <Path x:Name="pathChartStroke" Stretch="Fill" Stroke="#00D2FF" StrokeThickness="2.5"/>
                                </Grid>

                                <Grid VerticalAlignment="Bottom" Margin="35,0,10,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="00:00" Foreground="#4A5A63" FontSize="10"/>
                                    <TextBlock Grid.Column="1" Text="04:00" Foreground="#4A5A63" FontSize="10"/>
                                    <TextBlock Grid.Column="2" Text="08:00" Foreground="#4A5A63" FontSize="10"/>
                                    <TextBlock Grid.Column="3" Text="12:00" Foreground="#4A5A63" FontSize="10"/>
                                    <TextBlock Grid.Column="4" Text="16:00" Foreground="#4A5A63" FontSize="10"/>
                                    <TextBlock Grid.Column="5" Text="20:00" Foreground="#4A5A63" FontSize="10" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= VIEW 2: PETA AQI (N/A PLACEHOLDER) ================= -->
            <ScrollViewer x:Name="panelPetaAqi" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,25">
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Peta Kualitas Udara (AQI)" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Visualisasi polusi udara di berbagai kota di Indonesia secara real-time." FontSize="13" Foreground="#8E9FA8" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Large Map N/A Placeholder Container -->
                    <Border CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Height="500">
                        <Grid>
                            <Canvas Opacity="0.15">
                                <Line X1="0" Y1="100" X2="900" Y2="100" Stroke="#1C2E37" StrokeThickness="1" StrokeDashArray="4 4"/>
                                <Line X1="0" Y1="250" X2="900" Y2="250" Stroke="#1C2E37" StrokeThickness="1" StrokeDashArray="4 4"/>
                                <Line X1="0" Y1="400" X2="900" Y2="400" Stroke="#1C2E37" StrokeThickness="1" StrokeDashArray="4 4"/>
                                <Line X1="220" Y1="0" X2="220" Y2="500" Stroke="#1C2E37" StrokeThickness="1" StrokeDashArray="4 4"/>
                                <Line X1="450" Y1="0" X2="450" Y2="500" Stroke="#1C2E37" StrokeThickness="1" StrokeDashArray="4 4"/>
                                <Line X1="680" Y1="0" X2="680" Y2="500" Stroke="#1C2E37" StrokeThickness="1" StrokeDashArray="4 4"/>
                            </Canvas>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="12" Background="#0C151A" BorderBrush="#16242B" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <Path Width="24" Height="24" Stretch="Uniform" Fill="#4E606A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M9 3L3 6v15l6-3 6 3 6-3V3l-6 3-6-3zm1 3.5l4 2v10l-4-2v-10z"/>
                                </Border>
                                <TextBlock Text="N/A" FontSize="32" FontWeight="Bold" Foreground="#3A4D57" HorizontalAlignment="Center"/>
                                <TextBlock Text="Belum ada data stasiun pemantau peta AQI" FontSize="13" Foreground="#4E606A" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                
                                <Border CornerRadius="8" Background="#0C151A" BorderBrush="#182A33" BorderThickness="1" Padding="16,8" Margin="0,18,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="Stasiun Pemantau Aktif: 0 / N/A" FontSize="11.5" Foreground="#5A6D77"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= VIEW 3: LOG ENERGI (DUMMY DATA PER USER) ================= -->
            <ScrollViewer x:Name="panelLogEnergi" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,25">
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Log Energi &amp; Emisi" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Catat konsumsi energi harian untuk memantau jejak karbon Anda." FontSize="13" Foreground="#8E9FA8" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- User Switcher / Current User Badge -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="8" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Data pengguna: " Foreground="#8E9FA8" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtLogUserBadge" Text="user1" FontWeight="Bold" Foreground="#00E5FF" FontSize="12" VerticalAlignment="Center" Margin="4,0,10,0"/>
                                <Button x:Name="btnToggleUser" Content="Ganti User" Click="btnToggleUser_Click" Background="#142630" Foreground="#00D2FF" BorderBrush="#00B4D8" BorderThickness="1" Padding="8,2" FontSize="11" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Input Konsumsi -->
                        <Border Grid.Column="0" CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="22,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <Path Width="14" Height="14" Stretch="Uniform" Fill="#2ECC71" Margin="0,0,10,0" VerticalAlignment="Center"
                                          Data="M7 2v11h3v9l7-12h-4l4-8z"/>
                                    <TextBlock Text="Input Konsumsi" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Jenis Energi -->
                                <TextBlock Text="Jenis Energi" FontSize="11.5" Foreground="#8E9FA8" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Listrik (Active) -->
                                    <Border x:Name="borderEnergyListrik" Grid.Column="0" CornerRadius="8" Background="#142C33" BorderBrush="#00B4D8" BorderThickness="1" Height="42" Cursor="Hand" MouseLeftButtonDown="SelectEnergyListrik_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path x:Name="iconEnergyListrik" Width="12" Height="12" Stretch="Uniform" Fill="#00E5FF" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  Data="M7 2v11h3v9l7-12h-4l4-8z"/>
                                            <TextBlock x:Name="txtEnergyListrik" Text="Listrik" Foreground="#00E5FF" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- BBM (Inactive) -->
                                    <Border x:Name="borderEnergyBbm" Grid.Column="2" CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Height="42" Cursor="Hand" MouseLeftButtonDown="SelectEnergyBbm_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path x:Name="iconEnergyBbm" Width="12" Height="12" Stretch="Uniform" Fill="#657984" Margin="0,0,8,0" VerticalAlignment="Center"
                                                  Data="M19 5h-2V3H7v18h10v-2h2c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-4 14H9V5h6v14zm4-4h-2V7h2v8z"/>
                                            <TextBlock x:Name="txtEnergyBbm" Text="BBM" Foreground="#8E9FA8" FontSize="12.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Jumlah -->
                                <TextBlock x:Name="lblSatuanKonsumsi" Text="Jumlah (kWh)" FontSize="11.5" Foreground="#8E9FA8" Margin="0,0,0,8"/>
                                <Border CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Height="42" Margin="0,0,0,16">
                                    <Grid Margin="12,0">
                                        <TextBox x:Name="tbJumlahKonsumsi" Background="Transparent" Foreground="White" BorderThickness="0" 
                                                 VerticalContentAlignment="Center" FontSize="13" Text="10" CaretBrush="White"/>
                                    </Grid>
                                </Border>

                                <!-- Tanggal -->
                                <TextBlock Text="Tanggal (YYYY-MM-DD)" FontSize="11.5" Foreground="#8E9FA8" Margin="0,0,0,8"/>
                                <Border CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Height="42" Margin="0,0,0,22">
                                    <Grid Margin="12,0">
                                        <TextBox x:Name="tbTanggalKonsumsi" Background="Transparent" Foreground="White" BorderThickness="0" 
                                                 VerticalContentAlignment="Center" FontSize="13" Text="2026-09-07" CaretBrush="White"/>
                                    </Grid>
                                </Border>

                                <!-- Button Catat Jejak Karbon -->
                                <Button x:Name="btnCatatJejak" Height="44" Cursor="Hand" Click="btnCatatJejak_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="8">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00D2FF" Offset="0"/>
                                                        <GradientStop Color="#007BFF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="+ Catat Jejak Karbon" Foreground="White" FontWeight="Bold" FontSize="13.5" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Right Column: Riwayat Emisi (Dummy Data per User) -->
                        <Border Grid.Column="2" CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="22,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="#2ECC71" Margin="0,0,10,0" VerticalAlignment="Center"
                                              Data="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z"/>
                                        <TextBlock Text="Riwayat Emisi" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Total Badge -->
                                    <TextBlock x:Name="txtTotalEmisiSummary" Text="Total: 41.4 kg CO₂" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#00E5FF" FontWeight="SemiBold" FontSize="12.5"/>
                                </Grid>

                                <!-- List of emission entries (populated dynamically) -->
                                <StackPanel x:Name="panelDaftarEmisi"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= VIEW 4: PENGATURAN ================= -->
            <ScrollViewer x:Name="panelPengaturan" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,25">
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Pengaturan" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Konfigurasi preferensi aplikasi, parameter sensor, dan akun pengguna." FontSize="13" Foreground="#8E9FA8" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 1: Akun -->
                        <StackPanel Grid.Column="0">
                            <Border CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="22,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="#00D2FF" Margin="0,0,10,0" VerticalAlignment="Center"
                                              Data="M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm-6 14a6 6 0 0 1 12 0v1H6v-1z"/>
                                        <TextBlock Text="Profil Pengguna" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Username -->
                                    <TextBlock Text="Username Akun" FontSize="11.5" Foreground="#8E9FA8" Margin="0,0,0,6"/>
                                    <Border CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Height="40" Margin="0,0,0,14" Padding="12,0">
                                        <TextBlock x:Name="txtPengaturanUsername" Text="user1" Foreground="White" VerticalAlignment="Center" FontSize="13"/>
                                    </Border>

                                    <!-- Role -->
                                    <TextBlock Text="Hak Akses / Peran" FontSize="11.5" Foreground="#8E9FA8" Margin="0,0,0,6"/>
                                    <Border CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Height="40" Margin="0,0,0,14" Padding="12,0">
                                        <TextBlock x:Name="txtPengaturanRole" Text="User" Foreground="#8E9FA8" VerticalAlignment="Center" FontSize="13"/>
                                    </Border>

                                    <!-- Email -->
                                    <TextBlock Text="Email Terdaftar" FontSize="11.5" Foreground="#8E9FA8" Margin="0,0,0,6"/>
                                    <Border CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Height="40" Padding="12,0">
                                        <TextBlock x:Name="txtPengaturanEmail" Text="user1@carbonair.local" Foreground="#8E9FA8" VerticalAlignment="Center" FontSize="13"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Column 2: Preferensi Sistem & Sensor -->
                        <StackPanel Grid.Column="2">
                            <Border CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="22,20" Margin="0,0,0,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="#2ECC71" Margin="0,0,10,0" VerticalAlignment="Center"
                                              Data="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm-1-6h2l.7 2.2a8 8 0 0 1 2.3 1l2-1.2 1.4 1.4-1.2 2a8 8 0 0 1 1 2.3L22 11v2l-2.2.7a8 8 0 0 1-1 2.3l1.2 2-1.4 1.4-2-1.2a8 8 0 0 1-2.3 1L13 22h-2l-.7-2.2a8 8 0 0 1-2.3-1l-2 1.2-1.4-1.4 1.2-2a8 8 0 0 1-1-2.3L2 13v-2l2.2-.7a8 8 0 0 1 1-2.3l-1.2-2 1.4-1.4 2 1.2a8 8 0 0 1 2.3-1L11 2z"/>
                                        <TextBlock Text="Preferensi Sistem &amp; Sensor" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Satuan Emisi -->
                                    <TextBlock Text="Satuan Jejak Karbon" FontSize="11.5" Foreground="#8E9FA8" Margin="0,0,0,6"/>
                                    <Border CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Height="40" Margin="0,0,0,14" Padding="12,0">
                                        <TextBlock Text="kg CO₂ (Kilogram Karbon Dioksida)" Foreground="White" VerticalAlignment="Center" FontSize="13"/>
                                    </Border>

                                    <!-- Status API -->
                                    <TextBlock Text="Koneksi Gateway Sensor" FontSize="11.5" Foreground="#8E9FA8" Margin="0,0,0,6"/>
                                    <Border CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Height="40" Margin="0,0,0,14" Padding="12,0">
                                        <TextBlock Text="N/A (Offline / Standalone)" Foreground="#657984" VerticalAlignment="Center" FontSize="13"/>
                                    </Border>

                                    <!-- Frekuensi Sinkronisasi -->
                                    <TextBlock Text="Interval Pembaruan Data" FontSize="11.5" Foreground="#8E9FA8" Margin="0,0,0,6"/>
                                    <Border CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Height="40" Padding="12,0">
                                        <TextBlock Text="N/A" Foreground="#657984" VerticalAlignment="Center" FontSize="13"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Simpan Button -->
                            <Button x:Name="btnSimpanPengaturan" Height="44" Cursor="Hand" Click="btnSimpanPengaturan_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00D2FF" Offset="0"/>
                                                    <GradientStop Color="#007BFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="Simpan Pengaturan" Foreground="White" FontWeight="Bold" FontSize="13.5" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
