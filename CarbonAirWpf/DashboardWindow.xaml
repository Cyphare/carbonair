                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Konfirmasi" FontSize="11.5" Foreground="#8E9FA8" Margin="0,0,0,5"/>
                                            <Border CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Height="36">
                                                <PasswordBox x:Name="tbConfirmNewPassword" Background="Transparent" Foreground="White" BorderThickness="0"
                                                             Padding="12,0" VerticalContentAlignment="Center" FontSize="12.5" CaretBrush="White"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Button x:Name="btnChangePassword" Click="btnChangePassword_Click" Cursor="Hand" Height="36">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="8" Background="#142630" BorderBrush="#00B4D8" BorderThickness="1">
                                                    <TextBlock Text="Ubah Password" Foreground="#00E5FF" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Column 2: Sistem, API, Notifikasi & Database -->
                        <StackPanel Grid.Column="2">
                            <Border CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="20,18" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="#2ECC71" Margin="0,0,10,0" VerticalAlignment="Center"
                                              Data="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm-1-6h2l.7 2.2a8 8 0 0 1 2.3 1l2-1.2 1.4 1.4-1.2 2a8 8 0 0 1 1 2.3L22 11v2l-2.2.7a8 8 0 0 1-1 2.3l1.2 2-1.4 1.4-2-1.2a8 8 0 0 1-2.3 1L13 22h-2l-.7-2.2a8 8 0 0 1-2.3-1l-2 1.2-1.4-1.4 1.2-2a8 8 0 0 1-1-2.3L2 13v-2l2.2-.7a8 8 0 0 1 1-2.3l-1.2-2 1.4-1.4 2 1.2a8 8 0 0 1 2.3-1L11 2z"/>
                                        <TextBlock Text="Preferensi Sistem, Web API &amp; Notifikasi" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="Satuan Jejak Karbon" FontSize="11.5" Foreground="#8E9FA8" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cbEmissionUnit" Margin="0,0,0,12">
                                        <ComboBoxItem Content="kg CO₂ (Kilogram Karbon Dioksida)" Tag="kg"/>
                                        <ComboBoxItem Content="ton CO₂ (Metrik Ton)" Tag="ton"/>
                                    </ComboBox>

                                    <TextBlock Text="Koneksi Web REST API (Open-Meteo)" FontSize="11.5" Foreground="#8E9FA8" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Height="38" Padding="12,0">
                                            <TextBlock x:Name="txtSettingsApiStatus" Text="Open-Meteo Air Quality &amp; Weather API" Foreground="#2ECC71" VerticalAlignment="Center" FontSize="12"/>
                                        </Border>
                                        <Button x:Name="btnTestApi" Grid.Column="2" Click="btnTestApi_Click" Cursor="Hand" Height="38">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="8" Background="#142630" BorderBrush="#00B4D8" BorderThickness="1" Padding="12,0">
                                                        <TextBlock Text="Tes API" Foreground="#00E5FF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="Interval Auto-Refresh Data API" FontSize="11.5" Foreground="#8E9FA8" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cbAutoRefresh" Margin="0,0,0,14">
                                        <ComboBoxItem Content="Manual (Nonaktif)" Tag="0"/>
                                        <ComboBoxItem Content="Setiap 5 Menit" Tag="5"/>
                                        <ComboBoxItem Content="Setiap 15 Menit" Tag="15"/>
                                        <ComboBoxItem Content="Setiap 30 Menit" Tag="30"/>
                                    </ComboBox>

                                    <CheckBox x:Name="chkEnableAlerts" Content="Aktifkan Notifikasi Bahaya Polusi Desktop" IsChecked="True" Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Ambang Batas Peringatan (US AQI)" FontSize="11.5" Foreground="#8E9FA8" Margin="0,0,0,5"/>
                                            <Border CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Height="38">
                                                <TextBox x:Name="tbAlertThreshold" Background="Transparent" Foreground="White" BorderThickness="0"
                                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="13" Text="100" CaretBrush="White"/>
                                            </Border>
                                        </StackPanel>
                                        <Button x:Name="btnTestAlert" Grid.Column="2" Click="btnTestAlert_Click" Cursor="Hand" Height="38" VerticalAlignment="Bottom">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="8" Background="#2A1414" BorderBrush="#E74C3C" BorderThickness="1" Padding="12,0">
                                                        <TextBlock Text="Uji Notifikasi" Foreground="#FF8787" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Database Card -->
                            <Border CornerRadius="10" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" Padding="20,16" Margin="0,0,0,16">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Database Penyimpanan Aktif" FontSize="13.5" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock x:Name="txtSettingsDbInfo" Text="SQLite (carbonair.db)" FontSize="11.5" Foreground="#8E9FA8" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="btnSettingsDbConfig" HorizontalAlignment="Right" Click="btnSettingsDbConfig_Click" Cursor="Hand" Height="36">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="8" Background="#142630" BorderBrush="#00B4D8" BorderThickness="1" Padding="12,0">
                                                    <TextBlock Text="Atur Database..." Foreground="#00E5FF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Save Settings Button -->
                            <Button x:Name="btnSaveSettings" Height="44" Cursor="Hand" Click="btnSaveSettings_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00D2FF" Offset="0"/>
                                                    <GradientStop Color="#007BFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="Simpan Pengaturan" Foreground="White" FontWeight="Bold" FontSize="13.5"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
