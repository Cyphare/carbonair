<Window x:Class="CarbonAirWpf.DbConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CarbonAir - Konfigurasi Database"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF">
    <StackPanel Margin="28,24">
        <!-- Header -->
        <TextBlock Text="Konfigurasi Database" FontSize="17" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,18"/>

        <!-- Provider -->
        <TextBlock Text="Mode Database" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
        <ComboBox x:Name="cbProvider" SelectionChanged="cbProvider_SelectionChanged" Margin="0,0,0,14">
            <ComboBoxItem Content="SQLite (Lokal)" Tag="SQLite"/>
            <ComboBoxItem Content="PostgreSQL (Server)" Tag="PostgreSQL"/>
        </ComboBox>

        <!-- SQLite Panel -->
        <StackPanel x:Name="panelSqlite" Visibility="Visible">
            <TextBlock Text="Path File SQLite" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
            <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38">
                <TextBox x:Name="tbSqlitePath" Background="Transparent" Foreground="#111827" BorderThickness="0"
                         Padding="12,0" VerticalContentAlignment="Center" FontSize="13" CaretBrush="#111827"/>
            </Border>
        </StackPanel>

        <!-- PostgreSQL Panel -->
        <StackPanel x:Name="panelPostgres" Visibility="Collapsed">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Host Server" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38">
                        <TextBox x:Name="tbPgHost" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                 Padding="12,0" VerticalContentAlignment="Center" FontSize="13" CaretBrush="#111827"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Port" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38">
                        <TextBox x:Name="tbPgPort" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                 Padding="12,0" VerticalContentAlignment="Center" FontSize="13" CaretBrush="#111827"/>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="Nama Database" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
            <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38" Margin="0,0,0,12">
                <TextBox x:Name="tbPgDatabase" Background="Transparent" Foreground="#111827" BorderThickness="0"
                         Padding="12,0" VerticalContentAlignment="Center" FontSize="13" CaretBrush="#111827"/>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38">
                        <TextBox x:Name="tbPgUsername" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                 Padding="12,0" VerticalContentAlignment="Center" FontSize="13" CaretBrush="#111827"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38">
                        <PasswordBox x:Name="tbPgPassword" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                     Padding="12,0" VerticalContentAlignment="Center" FontSize="13" CaretBrush="#111827"/>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Status Result (visible only after testing/error) -->
        <Border x:Name="borderDbTestStatus" Visibility="Collapsed" CornerRadius="6"
                Background="#F4F6F8" BorderBrush="#0F766E" BorderThickness="3,0,0,0" Padding="12,9" Margin="0,16,0,0">
            <TextBlock x:Name="txtDbTestStatus" FontSize="11.5" TextWrapping="Wrap" Foreground="#111827"/>
        </Border>

        <!-- Action Buttons -->
        <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnTestDb" Grid.Column="0" Click="btnTestDb_Click" Cursor="Hand" Height="36">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Padding="14,0">
                            <TextBlock Text="Tes Koneksi" Foreground="#111827" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnCancelDb" Grid.Column="2" Click="btnCancelDb_Click" Cursor="Hand" Height="36">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Padding="16,0">
                            <TextBlock Text="Batal" Foreground="#111827" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnSaveDb" Grid.Column="4" Click="btnSaveDb_Click" Cursor="Hand" Height="36">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="#0F766E" BorderThickness="0" Padding="18,0">
                            <TextBlock Text="Simpan" Foreground="White" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </StackPanel>
</Window>
