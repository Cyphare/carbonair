<Window x:Class="CarbonAirWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CarbonAir - Login" Height="620" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#0B1317">
    <Grid Background="#0B1317">
        <!-- Center Login Card -->
        <Border Width="370" CornerRadius="12" Background="#111D23" BorderBrush="#1C2E37" BorderThickness="1" 
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36,32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.5" Direction="270" ShadowDepth="10"/>
            </Border.Effect>
            <StackPanel>
                <!-- Glowing Leaf Logo -->
                <Border Width="50" Height="50" CornerRadius="10" Background="#00B4D8" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Color="#00B4D8" Opacity="0.7" ShadowDepth="0"/>
                    </Border.Effect>
                    <!-- Clean Vector Leaf Icon (No Emoji) -->
                    <Path Width="24" Height="24" Stretch="Uniform" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z"/>
                </Border>

                <!-- Titles -->
                <TextBlock Text="CarbonAir" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,14,0,3"/>
                <TextBlock Text="Masuk ke akun Anda" FontSize="12" Foreground="#8E9FA8" HorizontalAlignment="Center" Margin="0,0,0,26"/>

                <!-- Username Input -->
                <TextBlock Text="Username" FontSize="12" Foreground="#A0B2BC" Margin="0,0,0,6"/>
                <Border CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Height="42" Margin="0,0,0,16">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- User icon -->
                        <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" Fill="#657984" VerticalAlignment="Center"
                              Data="M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm-6 14a6 6 0 0 1 12 0v1H6v-1z"/>
                        <TextBox Grid.Column="1" x:Name="tbUsername" Background="Transparent" Foreground="White" BorderThickness="0" 
                                 Margin="8,0,0,0" VerticalContentAlignment="Center" FontSize="13" Text="user1" CaretBrush="White"/>
                    </Grid>
                </Border>

                <!-- Password Input -->
                <TextBlock Text="Password" FontSize="12" Foreground="#A0B2BC" Margin="0,0,0,6"/>
                <Border CornerRadius="8" Background="#0B1418" BorderBrush="#1C2E37" BorderThickness="1" Height="42" Margin="0,0,0,24">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Lock icon -->
                        <Path Grid.Column="0" Width="14" Height="14" Stretch="Uniform" Fill="#657984" VerticalAlignment="Center"
                              Data="M6 10V7a6 6 0 1 1 12 0v3h1a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h1zm2 0h8V7a4 4 0 1 0-8 0v3zm4 5a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"/>
                        <PasswordBox Grid.Column="1" x:Name="tbPassword" Background="Transparent" Foreground="White" BorderThickness="0" 
                                     Margin="8,0,0,0" VerticalContentAlignment="Center" FontSize="13" Password="user1" CaretBrush="White"/>
                    </Grid>
                </Border>

                <!-- Login Button -->
                <Button x:Name="btnLogin" Height="44" Cursor="Hand" Click="btnLogin_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00D2FF" Offset="0"/>
                                        <GradientStop Color="#007BFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="Login  ➜" Foreground="White" FontWeight="Bold" FontSize="13.5" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Footer -->
                <TextBlock Text="Belum punya akun? Daftar di sini" FontSize="11" Foreground="#657984" 
                           HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
