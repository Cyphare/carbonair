<Window x:Class="CarbonAirWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CarbonAir - Login" Height="680" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F2F4F7">
    <Grid Background="#F2F4F7">
        <!-- Center Auth Surface -->
        <Border Width="360" CornerRadius="8" Background="#FFFFFF" BorderThickness="0"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="34,32">
            <StackPanel>
                <!-- Clean Horizontal Brand Mark -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,26">
                    <Path Width="20" Height="20" Stretch="Uniform" Fill="#0F766E" VerticalAlignment="Center"
                          Data="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z"/>
                    <TextBlock x:Name="txtAuthTitle" Text="CarbonAir" FontSize="20" FontWeight="Bold" Foreground="#111827"
                               VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>

                <!-- ================= LOGIN PANEL ================= -->
                <StackPanel x:Name="panelLogin" Visibility="Visible">
                    <!-- Username Input -->
                    <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="40" Margin="0,0,0,14">
                        <TextBox x:Name="tbUsername" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                 Padding="12,0" VerticalContentAlignment="Center" FontSize="13" Text="user1" CaretBrush="#111827"
                                 KeyDown="InputField_KeyDown"/>
                    </Border>

                    <!-- Password Input -->
                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="40" Margin="0,0,0,22">
                        <PasswordBox x:Name="tbPassword" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                     Padding="12,0" VerticalContentAlignment="Center" FontSize="13" Password="user1" CaretBrush="#111827"
                                     KeyDown="InputField_KeyDown"/>
                    </Border>

                    <!-- Login Button -->
                    <Button x:Name="btnLogin" Height="40" Cursor="Hand" Click="btnLogin_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="6" Background="#0F766E" BorderThickness="0">
                                    <TextBlock Text="Masuk" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Switch to Register -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <TextBlock Text="Belum punya akun? " FontSize="12" Foreground="#52525B"/>
                        <TextBlock Text="Daftar" FontSize="12" Foreground="#0F766E" FontWeight="SemiBold"
                                   Cursor="Hand" MouseLeftButtonDown="SwitchToRegister_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- ================= REGISTER PANEL ================= -->
                <StackPanel x:Name="panelRegister" Visibility="Collapsed">
                    <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                    <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38" Margin="0,0,0,10">
                        <TextBox x:Name="tbRegUsername" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                 Padding="12,0" VerticalContentAlignment="Center" FontSize="12.5" CaretBrush="#111827"/>
                    </Border>

                    <TextBlock Text="Email" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                    <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38" Margin="0,0,0,10">
                        <TextBox x:Name="tbRegEmail" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                 Padding="12,0" VerticalContentAlignment="Center" FontSize="12.5" CaretBrush="#111827"/>
                    </Border>

                    <TextBlock Text="Kota Default" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbRegCity" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38">
                                <PasswordBox x:Name="tbRegPassword" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                             Padding="12,0" VerticalContentAlignment="Center" FontSize="12.5" CaretBrush="#111827"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Konfirmasi" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
                            <Border CornerRadius="6" Background="#EBEEF2" BorderThickness="0" Height="38">
                                <PasswordBox x:Name="tbRegConfirmPassword" Background="Transparent" Foreground="#111827" BorderThickness="0"
                                             Padding="12,0" VerticalContentAlignment="Center" FontSize="12.5" CaretBrush="#111827"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="btnRegister" Height="40" Cursor="Hand" Click="btnRegister_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="6" Background="#0F766E" BorderThickness="0">
                                    <TextBlock Text="Daftar" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <TextBlock Text="Sudah punya akun? " FontSize="12" Foreground="#52525B"/>
                        <TextBlock Text="Masuk" FontSize="12" Foreground="#0F766E" FontWeight="SemiBold"
                                   Cursor="Hand" MouseLeftButtonDown="SwitchToLogin_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Quiet Borderless DB Config Link -->
                <Button x:Name="btnOpenDbConfig" HorizontalAlignment="Center" Margin="0,14,0,0"
                        Click="btnOpenDbConfig_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="8,4">
                                <TextBlock Text="Konfigurasi Database" FontSize="11.5" Foreground="#374151"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
